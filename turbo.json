{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", ".next/**", "!.next/cache/**", "cdk.out/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "outputs": [],
      "env": ["DYNAMODB_ENDPOINT", "CLOUDSENTRY_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
